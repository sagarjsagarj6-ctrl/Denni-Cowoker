APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./.data/dynamic_agents.db
REDIS_URL=redis://localhost:6379/0
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Hosted Google Gemini provider (get a key from Google AI Studio).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Fully free local provider (no API key). Start with `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
MAX_AGENTS_PER_RUN=12
MAX_TASKS_PER_RUN=32
MAX_PARALLEL_TASKS=8
MAX_MODEL_CALLS=100
MAX_TOOL_CALLS_PER_AGENT=20
RUN_TIMEOUT_SECONDS=1800
MAX_FILE_SIZE_BYTES=10485760
KNOWLEDGE_TOP_K=8
ALLOWED_HTTP_DOMAINS=
DATA_DIR=.data
LOG_JSON=false
